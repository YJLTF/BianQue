# 扁鹊前端镜像 = 纯运行环境承载（Nginx + 反代配置）；静态产物 deploy/artifacts/web 经 volumes 挂载
# 定位：内网快速移植运行——环境不变则镜像不重建；前端更新 = 替换 deploy/artifacts/web + restart（甚至免重启）
# 构建（一次性或环境变化时）：docker build -f deploy/docker/Dockerfile.web -t bianque/web:latest .
# 构建上下文 = 仓库根目录
FROM nginx:1.27-alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
