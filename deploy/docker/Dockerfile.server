# 扁鹊平台服务端镜像 = 纯运行环境承载（JRE 21 + 离线文档 + 入口脚本），产物不进镜像
# 定位：内网快速移植运行——环境不变则镜像不重建；升级 = 替换 deploy/artifacts 产物 + compose restart
# 构建（一次性或环境变化时）：docker build -f deploy/docker/Dockerfile.server -t bianque/server:latest .
# 运行：compose 将 deploy/artifacts 挂到 /app/artifacts（bq-server.jar / bq-agent.jar），见 docker-compose.prod.yml
FROM eclipse-temurin:21-jre
WORKDIR /app
# 文档中心按相对路径探测：78 页官方离线文档属环境级内容，随镜像分发
COPY docs/arthas-docs/ /app/docs/arthas-docs/
COPY deploy/docker/server-entrypoint.sh /app/server-entrypoint.sh
RUN chmod +x /app/server-entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/app/server-entrypoint.sh"]
