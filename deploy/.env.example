# ============================================================
# 扁鹊 BianQue 部署配置模板
# 用法: cp .env.example .env && 按需修改（compose 自动读取同目录 .env）
# 原则: 仓库与镜像不含任何真实密钥；生产环境务必逐项改掉默认值
# ============================================================

# ---- 版本 ----
# 平台镜像 tag（升级时同步修改；与 CHANGELOG 版本一致）
BQ_VERSION=1.0.0

# ---- 安全令牌（生产必配） ----
# 节点探针接入令牌（X-Agent-Token），需与探针侧 AGENT_TOKEN 一致。
# 生产模式（BIANQUE_DEMO_ENABLED=false）必配：未配置时服务端拒绝启动（/api/agent/** 禁止开放接入）
AGENT_TOKEN=
# 外部告警接入令牌（X-Alert-Token），配置后开放 POST /api/alerts/ingest；为空=关闭
INGEST_TOKEN=

# ---- AI 问诊（LLM 接入） ----
# OpenAI Chat Completions 兼容端点（不含 /chat/completions 尾巴）；留空则部署后在「AI 问诊」页填写
LLM_BASE_URL=
# LLM API Key 预置（也可部署后在页面填写，落库加密存储、只回传掩码）
LLM_API_KEY=

# ---- 生产形态（演示内容开关） ----
# false=生产模式：不注入模拟靶场实例/种子告警，不创建演示账号 ops/viewer；
# true=演示模式（完整靶场演示）。本地体验/内网演示可设 true。
BIANQUE_DEMO_ENABLED=false
# 生产模式下引导 admin 账号的初始口令（仅首次启动、admin 不存在时生效一次；至少 6 位）。
# 演示模式（DEMO_ENABLED=true）无需此项（内置 admin/admin123）。
BIANQUE_ADMIN_PASSWORD=

# ---- 基础设施 ----
# MySQL 业务账号密码（默认 bianque123 仅限内网演示）。
# 注意：MySQL 密码仅在数据卷首次初始化时生效；已初始化的环境改密码用
#   docker exec bq-mysql sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "ALTER USER \"bianque\"@\"%\" IDENTIFIED BY \"<新密码>\""'
# 或删除 mysql-data 卷重新初始化（会清空数据）。该密码由 compose 同时传给 MySQL 与服务端，两侧自动一致。
BIANQUE_DB_PASSWORD=bianque123
MYSQL_ROOT_PASSWORD=bianque_dev_only
# 前端对外端口
WEB_PORT=80
# 本机探针演示节点（--profile probe 时生效）：显示名默认取 hostname；心跳间隔秒数默认 5
PROBE_NAME=
PROBE_INTERVAL=5
